<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Pokéwalker step sync (only read when the user taps "Sync steps") -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Pokéwalker: hourly step sync while no screen of the app is open (if Health Connect allows it) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Health Connect needs Android 9+; the client library declares minSdk 26 and is only used on 28+. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".MelonDSApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:isGame="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".ui.romlist.RomListActivity"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.romdetails.RomDetailsActivity"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.emulator.EmulatorActivity"
            android:theme="@style/EmulatorTheme"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.LAUNCH_ROM" />
                <action android:name="${applicationId}.LAUNCH_FIRMWARE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.dsiwaremanager.DSiWareManagerActivity"
            android:label="@string/dsiware_manager"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:label="@string/title_activity_settings"
            android:parentActivityName=".ui.romlist.RomListActivity"
            android:launchMode="singleTop">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="me.magnum.melonds.ui.romlist.RomListActivity"/>
        </activity>
        <activity
            android:name=".ui.inputsetup.InputSetupActivity"
            android:label="@string/key_mapping"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:exported="false" >
        </activity>
        <activity
            android:name=".ui.shortcutsetup.ShortcutSetupActivity"
            android:label="@string/rom_shortcut"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.shortcutsetup.DSFirmwareShortcutSetupActivity"
            android:label="DS Firmware"
            android:icon="@mipmap/ic_platform_ds"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.shortcutsetup.DSiFirmwareShortcutSetupActivity"
            android:label="DSi Firmware"
            android:icon="@mipmap/ic_platform_dsi"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.cheats.CheatsActivity"
            android:label="@string/cheats"
            android:exported="false" >
        </activity>
        <activity
            android:name=".ui.layouts.LayoutListActivity"
            android:label="@string/layouts"
            android:parentActivityName=".ui.settings.SettingsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.layouts.LayoutSelectorActivity"
            android:label="@string/layouts"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.layouteditor.LayoutEditorActivity"
            android:theme="@style/EmulatorTheme"
            android:label="@string/layout_editor"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|uiMode" >
        </activity>
        <activity
            android:name=".ui.backgrounds.BackgroundsActivity"
            android:label="@string/backgrounds">
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <meta-data
                    android:name="me.magnum.melonds.initializer.AppForegroundStateTrackerInitializer"
                    android:value="androidx.startup" />

            <meta-data
                android:name="me.magnum.melonds.initializer.CoilInitializer"
                android:value="androidx.startup" />

            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- The virtual Pokéwalker as its own screen, with its own launcher icon. -->
        <activity
            android:name=".pokewalker.PokewalkerDeviceActivity"
            android:label="@string/pokewalker_device_label"
            android:icon="@mipmap/ic_pokewalker_device"
            android:roundIcon="@mipmap/ic_pokewalker_device"
            android:theme="@style/PokewalkerDeviceTheme"
            android:taskAffinity="${applicationId}.pokewalkerdevice"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|keyboard|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- "Sync steps" from the widget and launcher shortcut: on screen just long enough to read steps. -->
        <activity
            android:name=".pokewalker.PokewalkerSyncActivity"
            android:theme="@style/PokewalkerTranslucentTheme"
            android:taskAffinity="${applicationId}.pokewalkersync"
            android:excludeFromRecents="true"
            android:exported="false" />

        <receiver
            android:name=".pokewalker.PokewalkerWidget"
            android:label="@string/pokewalker_device_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pokewalker_widget_info" />
        </receiver>

        <service
            android:name=".pokewalker.PokewalkerTileService"
            android:label="@string/pokewalker_device_label"
            android:icon="@drawable/ic_pokewalker"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".pokewalker.HealthPermissionsRationaleActivity"
            android:label="@string/pokewalker_health_privacy_title"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".pokewalker.ViewPermissionUsageActivity"
            android:targetActivity=".pokewalker.HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
